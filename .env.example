# Retell Environment Variables Template
# Copy to .env.local and populate with your credentials.
# NEVER commit .env.local, .env, or actual API keys to source control.

NODE_ENV=development

# Primary AI Provider: Meta Model API
# Reasoning Model: muse-spark-1.3
# Transcription Model: muse-voice-transcribe-1.0
# Base URL: https://api.meta.ai/v1
# Real-time ASR WebSocket: wss://api.meta.ai/v1/asr/realtime
META_MODEL_API_KEY=
META_REASONING_MODEL=muse-spark-1.3
META_TRANSCRIPTION_MODEL=muse-voice-transcribe-1.0

# Alternative Reasoning Provider: Baseten
# Reasoning Model: meta-models/muse-spark-open-1026
# Base URL: https://inference.baseten.co/v1
BASETEN_API_KEY=
BASETEN_REASONING_MODEL=meta-models/muse-spark-open-1026

# Provider Selection (meta | baseten)
REASONING_PROVIDER=meta
TRANSCRIPTION_PROVIDER=meta

# Persistent Rate Limiting & Usage Accounting (Upstash Redis)
# Required in production for persistent rate limiting and spending protection.
# Get free REST credentials at https://console.upstash.com/
UPSTASH_REDIS_REST_URL=https://example-upstash-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here

# Global Daily Spending Cap & Security Controls
# Maximum aggregate daily AI expenditure across all anonymous users in USD.
# Daily budget resets strictly at 00:00:00 UTC.
RETELL_DAILY_BUDGET_USD=5.00

# Server-side HMAC secret for hashing anonymous device IDs and IP addresses before Redis storage
# (Zero PII stored in Redis; 32+ character hex string recommended)
RETELL_ANONYMOUS_HMAC_SECRET=your_random_secret_hmac_key_32_chars_or_more

# Operator Pricing Overrides (Optional; defaults match standard reasoning & ASR model tiers)
RETELL_PRICE_PER_1M_INPUT_TOKENS_USD=0.30
RETELL_PRICE_PER_1M_OUTPUT_TOKENS_USD=0.60
RETELL_PRICE_PER_AUDIO_MINUTE_USD=0.012
